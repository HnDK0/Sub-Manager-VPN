[Unit]
Description=vpn-sub-manager — 24/7 free-VPN subscription manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path to the built binary. The mihomo engine is embedded (no external
# core download); the binary serves subscriptions and self-refreshes via an
# in-process ticker — so NO systemd timer is needed. Logs go to journald.
ExecStart=%h/.local/bin/vpn-sub-manager
Restart=always
RestartSec=5
# Keep a runaway from starving the box.
MemoryMax=512M
Nice=10
# Bounded probe fans out up to 512 concurrent sockets (default 350), so raise
# the FD ceiling to avoid EMFILE under load.
LimitNOFILE=65536

[Install]
WantedBy=default.target
